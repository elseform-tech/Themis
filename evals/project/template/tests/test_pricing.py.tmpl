import unittest

from __pkg__.bundles import bundle_saving, line_price
from __pkg__.parser import parse_order
from __pkg__.pricing import price_order

from tests.support import ORDER_TEXT, catalog


class PricingTest(unittest.TestCase):
    def test_bundles(self):
        book = catalog().get("BK-1")
        self.assertEqual(line_price(book, 2), 800)
        self.assertEqual(line_price(book, 3), 1000)
        self.assertEqual(line_price(book, 7), 2400)
        self.assertEqual(bundle_saving(book, 6), 400)

    def test_quote_totals(self):
        quote = price_order(parse_order(ORDER_TEXT), catalog())
        self.assertEqual(quote.line_totals, (("BK-1", 1400), ("FD-1", 650), ("GN-1", 1999)))
        self.assertEqual((quote.subtotal_cents, quote.tax_cents, quote.total_cents), (4049, 446, 4495))

    def test_untaxed_books(self):
        quote = price_order(parse_order("order B\ncustomer C\nline BK-1 3\n"), catalog())
        self.assertEqual((quote.tax_cents, quote.total_cents), (0, 1000))


if __name__ == "__main__":
    unittest.main()
