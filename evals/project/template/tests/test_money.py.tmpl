import unittest

from __pkg__.errors import MoneyError
from __pkg__.money import basis_points_of, format_cents, parse_amount, percent_of


class MoneyTest(unittest.TestCase):
    def test_parse_amount(self):
        self.assertEqual(parse_amount("12.50"), 1250)
        self.assertEqual(parse_amount("12.5"), 1250)
        self.assertEqual(parse_amount("7"), 700)
        self.assertEqual(parse_amount("-0.05"), -5)

    def test_parse_amount_rejects_bad_text(self):
        for text in ["", "1.234", "abc", "1,50"]:
            with self.assertRaises(MoneyError):
                parse_amount(text)

    def test_format_cents(self):
        self.assertEqual(format_cents(1250), "12.50")
        self.assertEqual(format_cents(5), "0.05")
        self.assertEqual(format_cents(-305), "-3.05")

    def test_shares_are_whole_cents(self):
        self.assertEqual(percent_of(999, 10), 99)
        self.assertEqual(basis_points_of(650, 700), 46)
        self.assertEqual(basis_points_of(1999, 2000), 400)


if __name__ == "__main__":
    unittest.main()
