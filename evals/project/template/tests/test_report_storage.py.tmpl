import os
import tempfile
import unittest

from __pkg__.errors import StorageError
from __pkg__.parser import parse_order
from __pkg__.pricing import price_order
from __pkg__.report import render_quote
from __pkg__.storage import load_quote, quote_from_dict, save_quote

from tests.support import ORDER_TEXT, catalog


class ReportAndStorageTest(unittest.TestCase):
    def setUp(self):
        self.quote = price_order(parse_order(ORDER_TEXT), catalog())

    def test_report_lines(self):
        text = render_quote(self.quote, catalog(), "Test Person")
        self.assertTrue(text.startswith("Order T-1 (Test Person)\n"))
        self.assertIn("Field Notes", text)
        self.assertTrue(text.endswith("Subtotal: 40.49\nTax: 4.46\nTotal: 44.95\n"))

    def test_round_trip(self):
        with tempfile.TemporaryDirectory() as folder:
            path = os.path.join(folder, "quote.json")
            save_quote(self.quote, path)
            self.assertEqual(load_quote(path), self.quote)

    def test_bad_saved_quote(self):
        with self.assertRaises(StorageError):
            quote_from_dict({"order_id": "x"})


if __name__ == "__main__":
    unittest.main()
