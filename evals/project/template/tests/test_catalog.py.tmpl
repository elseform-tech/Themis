import unittest

from __pkg__.catalog import parse_catalog
from __pkg__.errors import CatalogError

from tests.support import CATALOG_TEXT, catalog


class CatalogTest(unittest.TestCase):
    def test_reads_products_and_bundles(self):
        products = catalog()
        self.assertEqual(len(products), 4)
        book = products.get("BK-1")
        self.assertEqual((book.unit_cents, book.bundle_size, book.bundle_cents), (400, 3, 1000))
        self.assertEqual(products.get("GN-1").bundle_size, 0)

    def test_unknown_sku(self):
        with self.assertRaises(CatalogError):
            catalog().get("NOPE")

    def test_rejects_bad_rows(self):
        header = CATALOG_TEXT.splitlines()[0]
        for row in ["X,Name,books,1.00,1,1.00", "X,Name,books,abc,0,", "X,Name,books,1.00,2,", "X,Name"]:
            with self.assertRaises(CatalogError, msg=row):
                parse_catalog(header + "\n" + row + "\n")

    def test_rejects_duplicates_and_missing_header(self):
        with self.assertRaises(CatalogError):
            parse_catalog(CATALOG_TEXT + "BK-1,Again,books,1.00,0,\n")
        with self.assertRaises(CatalogError):
            parse_catalog("BK-1,Field Notes,books,4.00,0,\n")


if __name__ == "__main__":
    unittest.main()
