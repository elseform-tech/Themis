"""Bundle offers: `bundle_size` units of one product for `bundle_cents`."""


def line_price(product, quantity):
    """Price for `quantity` units of one product, using its bundle offer where it applies."""
    if product.bundle_size and quantity >= product.bundle_size:
        bundles, rest = divmod(quantity, product.bundle_size)
        return bundles * product.bundle_cents + rest * product.unit_cents
    return quantity * product.unit_cents


def bundle_saving(product, quantity):
    """How much the bundle offer saves compared with paying the unit price for every unit."""
    return quantity * product.unit_cents - line_price(product, quantity)
