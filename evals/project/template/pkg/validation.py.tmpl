"""Checks that an order can be priced before quoting it."""

MAX_QUANTITY = 999


def problems(order, catalog):
    """Human-readable problems with an order; an empty list means it can be priced."""
    found = []
    for index, line in enumerate(order.lines, 1):
        if line.sku not in catalog:
            found.append(f"line {index}: unknown sku {line.sku}")
        if line.quantity > MAX_QUANTITY:
            found.append(f"line {index}: quantity {line.quantity} is above {MAX_QUANTITY}")
    return found


def require_valid(order, catalog):
    """Raise ValueError listing every problem when the order cannot be priced."""
    found = problems(order, catalog)
    if found:
        raise ValueError("; ".join(found))
