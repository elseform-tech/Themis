"""Order files.

    order A-100
    customer Dana Reyes
    line BK-1 2
    line FD-3 1

Blank lines and lines starting with '#' are ignored. `order` and `customer` come once, before
any `line`.
"""

from __pkg__.errors import OrderError
from __pkg__.models import Line, Order


def parse_order(text):
    """Parse order text into an Order; raises OrderError with the line number."""
    order_id = None
    customer = None
    lines = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        keyword, _, rest = line.partition(" ")
        rest = rest.strip()
        if keyword == "order":
            if order_id is not None or lines:
                raise OrderError(number, "'order' must come once, before the lines")
            if not rest or " " in rest:
                raise OrderError(number, "'order' needs one id")
            order_id = rest
        elif keyword == "customer":
            if customer is not None or lines:
                raise OrderError(number, "'customer' must come once, before the lines")
            if not rest:
                raise OrderError(number, "'customer' needs a name")
            customer = rest
        elif keyword == "line":
            lines.append(parse_line(number, rest))
        else:
            raise OrderError(number, f"unknown keyword {keyword!r}")
    if order_id is None:
        raise OrderError(0, "missing 'order'")
    if customer is None:
        raise OrderError(0, "missing 'customer'")
    if not lines:
        raise OrderError(0, "an order needs at least one line")
    return Order(order_id, customer, tuple(lines))


def parse_line(number, rest):
    """Parse the part of a `line` entry after the keyword: '<sku> <quantity>'."""
    fields = rest.split()
    if len(fields) != 2:
        raise OrderError(number, "'line' needs a sku and a quantity")
    sku, quantity = fields
    if not quantity.isdigit() or int(quantity) == 0:
        raise OrderError(number, f"quantity must be a positive whole number, got {quantity!r}")
    return Line(sku, int(quantity))


def load_order(path):
    """Read and parse an order file."""
    with open(path, encoding="utf-8") as handle:
        return parse_order(handle.read())
