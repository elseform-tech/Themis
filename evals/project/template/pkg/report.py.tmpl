"""Plain-text quote reports."""

from __pkg__.money import format_cents


def render_quote(quote, catalog, customer=""):
    """A quote as text: one row per line total, then Subtotal, Tax and Total."""
    title = f"Order {quote.order_id}" + (f" ({customer})" if customer else "")
    rows = [title]
    for sku, cents in quote.line_totals:
        name = catalog.get(sku).name
        rows.append(f"  {sku:<8} {name:<24} {format_cents(cents):>10}")
    rows.append(f"Subtotal: {format_cents(quote.subtotal_cents)}")
    rows.append(f"Tax: {format_cents(quote.tax_cents)}")
    rows.append(f"Total: {format_cents(quote.total_cents)}")
    return "\n".join(rows) + "\n"
