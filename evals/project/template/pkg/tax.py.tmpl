"""Sales tax by product category, in basis points (100 basis points = 1%)."""

from __pkg__.money import basis_points_of

RATES = __RATES__
DEFAULT_RATE = __DEFAULT_RATE__


def rate_for(category):
    """The tax rate for a category in basis points; unknown categories use DEFAULT_RATE."""
    return RATES.get(category, DEFAULT_RATE)


def tax_for(category, cents):
    """Tax on an amount of one category, rounded half up to whole cents."""
    return basis_points_of(cents, rate_for(category))
