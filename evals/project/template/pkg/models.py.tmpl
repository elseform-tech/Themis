"""Plain data types shared by the parser, pricing, reports and storage."""

from dataclasses import dataclass


@dataclass(frozen=True)
class Product:
    """A catalog entry. `bundle_size` units cost `bundle_cents` together (0 means no bundle)."""

    sku: str
    name: str
    category: str
    unit_cents: int
    bundle_size: int = 0
    bundle_cents: int = 0


@dataclass(frozen=True)
class Line:
    """One order line: a product and how many units."""

    sku: str
    quantity: int


@dataclass(frozen=True)
class Order:
    """A customer order with its lines in file order."""

    order_id: str
    customer: str
    lines: tuple


@dataclass(frozen=True)
class Quote:
    """A priced order. `line_totals` is a tuple of (sku, cents) pairs."""

    order_id: str
    line_totals: tuple
    subtotal_cents: int
    tax_cents: int
    total_cents: int
