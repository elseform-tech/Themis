"""Command line: `python -m __pkg__.cli quote ORDER --catalog CATALOG [--json OUT]`."""

import argparse
import sys

from __pkg__.catalog import load_catalog
from __pkg__.errors import PricingError
from __pkg__.parser import load_order
from __pkg__.pricing import price_order
from __pkg__.report import render_quote
from __pkg__.storage import save_quote
from __pkg__.validation import problems


def build_parser():
    """The argument parser for the command line."""
    parser = argparse.ArgumentParser(prog="__pkg__")
    commands = parser.add_subparsers(dest="command", required=True)
    quote = commands.add_parser("quote", help="price an order and print the quote")
    quote.add_argument("order", help="order file")
    quote.add_argument("--catalog", required=True, help="catalog CSV file")
    quote.add_argument("--json", help="also save the quote as JSON here")
    return parser


def main(argv=None, out=None):
    """Run the command line; returns the exit code (0 ok, 1 bad input)."""
    out = out or sys.stdout
    args = build_parser().parse_args(argv)
    try:
        catalog = load_catalog(args.catalog)
        order = load_order(args.order)
        found = problems(order, catalog)
        if found:
            for problem in found:
                print(f"error: {problem}", file=out)
            return 1
        quote = price_order(order, catalog)
    except (OSError, PricingError) as error:
        print(f"error: {error}", file=out)
        return 1
    out.write(render_quote(quote, catalog, order.customer))
    if args.json:
        save_quote(quote, args.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())
