"""Errors raised by __pkg__."""


class PricingError(Exception):
    """Base class for every error this package raises."""


class MoneyError(PricingError):
    """An amount could not be parsed."""


class CatalogError(PricingError):
    """The catalog is malformed or a product is unknown."""


class OrderError(PricingError):
    """An order file is malformed; `line` is the one-based line number (0 when unknown)."""

    def __init__(self, line, message):
        super().__init__(f"line {line}: {message}" if line else message)
        self.line = line


class StorageError(PricingError):
    """A saved quote could not be read or written."""
