"""Quotes for orders: bundle-aware line prices, discounts, tax per line, totals in cents."""

from __pkg__.bundles import line_price
from __pkg__.discounts import line_discount, order_discount
from __pkg__.models import Quote
from __pkg__.tax import tax_for


def price_order(order, catalog, rules=()):
    """Quote an order against a catalog, applying discount rules when given."""
    quantities = {}
    for line in order.lines:
        quantities[line.sku] = quantities.get(line.sku, 0) + line.quantity
    line_totals = []
    subtotal = tax = discount = net = 0
    for sku, quantity in quantities.items():
        product = catalog.get(sku)
        amount = line_price(product, quantity)
        off = line_discount(rules, product, quantity, amount)
        line_totals.append((sku, amount))
        subtotal += amount
        discount += off
        net += amount - off
        tax += tax_for(product.category, amount - off)
    discount += order_discount(rules, net)
    return Quote(order.order_id, tuple(line_totals), subtotal, tax, subtotal - discount + tax, discount)
