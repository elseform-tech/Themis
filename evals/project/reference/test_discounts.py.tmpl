import unittest

from __pkg__.discounts import parse_discounts
from __pkg__.errors import DiscountError
from __pkg__.parser import parse_order
from __pkg__.pricing import price_order

from tests.support import catalog


class DiscountTest(unittest.TestCase):
    def test_parse(self):
        rules = parse_discounts("# c\npercent books 10\nfixed GN-1 1.00\nthreshold 30.00 2.00\n")
        self.assertEqual([r.kind for r in rules], ["percent", "fixed", "threshold"])

    def test_bad_line(self):
        with self.assertRaises(DiscountError) as caught:
            parse_discounts("percent books 10\npercent books 0\n")
        self.assertEqual(caught.exception.line, 2)

    def test_price_with_rules(self):
        rules = parse_discounts("fixed GN-1 1.00\nthreshold 30.00 2.00\n")
        quote = price_order(parse_order("order A\ncustomer B\nline GN-1 2\n"), catalog(), rules)
        self.assertEqual((quote.subtotal_cents, quote.discount_cents), (3998, 400))

    def test_split_bundle_lines(self):
        quote = price_order(parse_order("order A\ncustomer B\nline BK-1 1\nline BK-1 2\n"), catalog())
        self.assertEqual(quote.total_cents, 1000)
