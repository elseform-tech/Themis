"""Discount rules, one per line: `percent <category> <1-100>`, `fixed <sku> <amount>` and
`threshold <minimum> <amount>`. Blank lines and '#' comments are ignored."""

from dataclasses import dataclass

from __pkg__.errors import DiscountError, MoneyError
from __pkg__.money import parse_amount, percent_of


@dataclass(frozen=True)
class Rule:
    """One discount rule: `kind` is percent, fixed or threshold."""

    kind: str
    target: object
    value: int


def parse_discounts(text):
    """Parse rules text into a list of Rule; raises DiscountError with the line number."""
    rules = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        kind = fields[0]
        if kind not in ("percent", "fixed", "threshold") or len(fields) != 3:
            raise DiscountError(number, f"expected '<percent|fixed|threshold> <a> <b>', got {line!r}")
        try:
            if kind == "percent":
                if not fields[2].isdigit() or not 1 <= int(fields[2]) <= 100:
                    raise DiscountError(number, "percent must be a whole number from 1 to 100")
                rules.append(Rule(kind, fields[1], int(fields[2])))
            elif kind == "fixed":
                rules.append(Rule(kind, fields[1], positive(number, fields[2])))
            else:
                rules.append(Rule(kind, positive(number, fields[1]), positive(number, fields[2])))
        except MoneyError as error:
            raise DiscountError(number, str(error)) from None
    return rules


def positive(number, text):
    """An amount in cents that must be above zero."""
    cents = parse_amount(text)
    if cents <= 0:
        raise DiscountError(number, "amounts must be above zero")
    return cents


def line_discount(rules, product, quantity, amount):
    """The larger of the best percent and the best fixed discount for one product line."""
    percent = max((r.value for r in rules if r.kind == "percent" and r.target == product.category), default=0)
    fixed = max((r.value for r in rules if r.kind == "fixed" and r.target == product.sku), default=0)
    return max(percent_of(amount, percent), min(amount, fixed * quantity))


def order_discount(rules, net):
    """The largest threshold discount the discounted subtotal qualifies for, at most that subtotal."""
    best = max((r.value for r in rules if r.kind == "threshold" and net >= r.target), default=0)
    return min(best, net)
